<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <Version>1.0.0.0</Version>
        <Description>Remembers where your items are and shares it with other plugins.</Description>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <NoWarn>$(NoWarn);CA1711;CA1305</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="Localization\**\*.json" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Images\*.png" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Images\MogVault.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\docs\MogVaultIpc.cs" Link="Ipc\MogVaultIpc.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(UnderlingsProjectPath)" />
    </ItemGroup>
</Project>
